# Copy this file to .env and fill in real values before deploying to production

PORT=4000

# JWT secret used to sign session tokens - CHANGE THIS to a long random string
JWT_SECRET=change_this_to_a_long_random_secret_string

# Google OAuth - create credentials at https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origin must be your real domain, e.g. https://vizochat.online
GOOGLE_CLIENT_ID=

# If GOOGLE_CLIENT_ID is left empty, the server falls back to a DEMO login
# (creates a random test user) so you can run and test the app immediately.

# Payment gateway (example: Razorpay / Stripe) - fill in when you integrate a real provider
PAYMENT_PROVIDER_KEY_ID=
PAYMENT_PROVIDER_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Rolling window (minutes) and report threshold for auto-ban
REPORT_WINDOW_MINUTES=60
REPORT_BAN_THRESHOLD=5
BAN_DURATION_DAYS=21

# Coins <-> money withdrawal rate (coins per $1) - adjust to your real rate
EARNED_COINS_PER_DOLLAR=307
